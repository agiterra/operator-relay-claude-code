{
  "name": "@agiterra/operator-relay-claude-code",
  "version": "2.1.0",
  "description": "Operator-prompt relay for Claude Code \u2014 forwards operator prompts to managing agents via Wire.",
  "license": "MIT",
  "type": "module",
  "bin": "./server.ts",
  "scripts": {
    "start": "bun install --no-summary && ./node_modules/@agiterra/mcp-tee/bin/mcp-tee.sh operator-relay bun server.ts"
  },
  "files": [
    "hooks/",
    "skills/",
    ".claude-plugin/"
  ],
  "dependencies": {
    "@agiterra/mcp-tee": "agiterra/mcp-tee#v0.1.0",
    "@agiterra/operator-relay-tools": "agiterra/operator-relay-tools#v1.1.0",
    "@agiterra/wire-tools": "agiterra/wire-tools#v2.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "author": "Tim Garthwaite <https://github.com/mividtim>"
}